{
    "functions": {
        "api/python/*.py": {
            "runtime": "vercel-python@0.1.1"
        }
    },
    "rewrites": [
        {
            "source": "/api/py/:path*",
            "destination": "/api/python/index.py"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/oracle",
            "schedule": "0 0 * * *"
        }
    ]
}