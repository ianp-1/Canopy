{
    "crons": [
        {
            "path": "/api/cron/oracle",
            "schedule": "0 0 * * *"
        },
        {
            "path": "/api/cron/ping-supabase",
            "schedule": "0 12 * * *"
        }
    ],
    "rewrites": [
        {
            "source": "/api/py/:path*",
            "destination": "/backend/main.py"
        }
    ],
    "functions": {
        "src/app/actions/payment.ts": {
            "maxDuration": 60
        },
        "src/app/api/agent/review/route.ts": {
            "maxDuration": 60
        }
    }
}
