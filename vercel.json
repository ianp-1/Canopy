{
    "functions": {
        "api/*.py": {
            "runtime": "@vercel/python"
        }
    },
    "rewrites": [
        {
            "source": "/api/py/:path*",
            "destination": "/api/index.py"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/oracle",
            "schedule": "0 0 * * *"
        }
    ]
}