#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/ianpang/xrp_farmer/node_modules/.pnpm/next-devtools-mcp@0.3.10/node_modules/next-devtools-mcp/dist/node_modules:/Users/ianpang/xrp_farmer/node_modules/.pnpm/next-devtools-mcp@0.3.10/node_modules/next-devtools-mcp/node_modules:/Users/ianpang/xrp_farmer/node_modules/.pnpm/next-devtools-mcp@0.3.10/node_modules:/Users/ianpang/xrp_farmer/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/ianpang/xrp_farmer/node_modules/.pnpm/next-devtools-mcp@0.3.10/node_modules/next-devtools-mcp/dist/node_modules:/Users/ianpang/xrp_farmer/node_modules/.pnpm/next-devtools-mcp@0.3.10/node_modules/next-devtools-mcp/node_modules:/Users/ianpang/xrp_farmer/node_modules/.pnpm/next-devtools-mcp@0.3.10/node_modules:/Users/ianpang/xrp_farmer/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../dist/index.js" "$@"
else
  exec node  "$basedir/../../dist/index.js" "$@"
fi
