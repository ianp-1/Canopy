generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



// ═══════════════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════════════

enum PolicyStatus {
  ACTIVE
  CLAIMED
  EXPIRED
}

enum OracleAction {
  CHECK_TRIGGERED
  PAYOUT_SUCCESS
  PAYOUT_FAILED
  ESCROW_EXPIRED
}

enum UserRole {
  USER
  INSURER
  ADMIN
}

// ═══════════════════════════════════════════════════════════════════════════
// MODELS
// ═══════════════════════════════════════════════════════════════════════════

/// User - Farmers who purchase insurance policies
model User {
  id            String   @id @default(uuid())
  supabaseUid   String   @unique /// Link to Supabase Auth User ID
  email         String?  @unique /// Optional, for Google Auth users
  walletAddress String?  @unique /// XRPL Wallet Address (optional for email users initially)
  role          UserRole @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  policies Policy[]

  @@index([supabaseUid])
  @@map("users")
}


// Field model removed

/// Insurer - Insurance providers who fund escrows and sell policies
model Insurer {
  id             String   @id @default(uuid())
  name           String
  walletAddress  String   @unique /// XRPL wallet address (public)
  totalLiquidity Decimal  @default(0) @db.Decimal(18, 6) /// Total XRP in liquidity pool
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  policies Policy[]

  @@index([walletAddress])
  @@map("insurers")
}

/// Policy - Insurance policy linking farmer, insurer, and escrow
model Policy {
  id             String       @id @default(uuid())
  userId         String
  insurerId      String?
  region         String /// e.g., "California Central Valley"
  coverageAmount Decimal      @db.Decimal(18, 6) /// Amount in XRP (6 decimal precision)
  premiumAmount  Decimal?     @db.Decimal(18, 6) /// Premium paid by farmer
  premiumDetails Json? /// Details about premium calculation
  status         PolicyStatus @default(ACTIVE)

  // XRPL Escrow fields
  xrplEscrowId      String? /// Ledger index or escrow sequence
  escrowSequence    Int? /// EscrowCreate sequence number
  escrowCondition   String? /// Crypto-condition hex
  escrowFulfillment String? /// Fulfillment secret hex (sensitive!)

  // NFT fields
  nftTokenId    String? /// XLS-20 NFToken ID (64-char hex)
  nftMintTxHash String? /// NFT minting transaction hash

  // Weather/Oracle configuration
  weatherThumbnail      Json? /// Snapshot of weather criteria
  coordinates           Json? /// { lat: number, lng: number }
  geometry              Json? /// Snapshot of field geometry (GeoJSON)
  thresholdRainfall     Float? /// Trigger threshold in mm
  thresholdTemp         Float? /// Temperature threshold (°C)
  thresholdSoilMoisture Float? /// Soil moisture threshold (%)
  
  // Crop profile thresholds (for oracle evaluation)
  weeklyRainNeedMm      Float? /// Weekly rainfall need in mm (e.g., 45 for corn)
  heatThresholdK        Float? /// Heat stress threshold in Kelvin (e.g., 308 for corn)
  vpdThresholdKpa       Float? /// VPD stress threshold in kPa (e.g., 1.6 for corn)

  // Claim fields
  claimTxHash String? /// EscrowFinish transaction hash
  claimedAt   DateTime? /// When payout was triggered

  // Timestamps
  expiresAt DateTime? /// Policy expiration date
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  insurer     Insurer?     @relation(fields: [insurerId], references: [id], onDelete: SetNull)
  oracleLogs  OracleLog[]

  @@index([userId])
  @@index([insurerId])
  @@index([status])
  @@index([expiresAt])
  @@map("policies")
}

// WeatherLog model removed

/// OracleLog - Audit trail for oracle decisions and actions
model OracleLog {
  id             String       @id @default(uuid())
  policyId       String
  action         OracleAction
  consensusScore Float? /// 0.0 - 1.0 confidence score
  weatherData    Json? /// Snapshot of weather data used for decision
  txHash         String? /// XRPL transaction hash (if applicable)
  errorMessage   String? /// Error details (if failed)
  createdAt      DateTime     @default(now())

  // Relations
  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@index([action])
  @@index([createdAt])
  @@map("oracle_logs")
}
