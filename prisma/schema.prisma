generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  supabaseUid   String   @unique // Link to Supabase Auth User ID
  email         String?  @unique // Optional, for Google Auth users
  walletAddress String?  @unique // XRPL Wallet Address (optional for email users initially)
  createdAt     DateTime @default(now())
  policies      Policy[]

  @@index([supabaseUid])
}

model Policy {
  id                 String       @id @default(uuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id])

  @@index([userId])
  region             String       // e.g., "California Central Valley"
  coverageAmount     Float        // Amount in XRP
  premiumDetails     Json?        // Details about premium calculation
  status             PolicyStatus @default(ACTIVE)
  xrplEscrowId       String?      // Ledger index or escrow sequence
  nftTokenId         String?      // XLS-20 NFToken ID (64-char hex)
  nftMintTxHash      String?      // NFT minting transaction hash
  weatherThumbnail   Json?        // Snapshot of weather criteria
  // Phase 3: Oracle fields
  escrowSequence     Int?         // EscrowCreate sequence number
  escrowCondition    String?      // Crypto-condition hex
  escrowFulfillment  String?      // Fulfillment secret hex (sensitive!)
  thresholdRainfall  Float?       // Trigger threshold in mm
  coordinates        Json?        // { lat: number, lng: number }
  claimTxHash        String?      // EscrowFinish transaction hash
  claimedAt          DateTime?    // When payout was triggered
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  weatherLogs        WeatherLog[]
}

model WeatherLog {
  id           String   @id @default(uuid())
  policyId     String
  policy       Policy   @relation(fields: [policyId], references: [id])

  @@index([policyId])
  data         Json     // Raw data from Oracle (OpenWeather/NOAA)
  timestamp    DateTime @default(now())
  isTriggerMet Boolean  @default(false)
}

enum PolicyStatus {
  ACTIVE
  CLAIMED
  EXPIRED
}
